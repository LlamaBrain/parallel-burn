{
  "name": "@llamabrain/parallel-burn",
  "version": "0.4.0",
  "description": "Claude Code plugin that surfaces parallelism, cache discipline, and retail-price cost from your live sessions.",
  "license": "Apache-2.0",
  "author": "Michael Tiller <metagrue@gmail.com> (LlamaBrain Labs LLC)",
  "homepage": "https://github.com/LlamaBrain/parallel-burn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LlamaBrain/parallel-burn.git"
  },
  "bugs": {
    "url": "https://github.com/LlamaBrain/parallel-burn/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "plugin.json",
    "pricing.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
